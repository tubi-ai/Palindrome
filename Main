package com.company;

import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Enter the number of strings: ");
        int N = getValidInt(sc);

        inputArrayList list = new inputArrayList(N);

        for (int i = 0; i < N; i++) {
            System.out.print("Enter a String: ");
            String s = sc.next();
            list.addArrayList(s);

            if (list.isPalindromeString(s)) {
                System.out.println('"' + s + "\" is a palindrome!");
            } else {
                System.out.println('"' + s + "\" is not a palindrome.");
            }
        }

        System.out.print("Enter an index to update (or -1 to skip): ");
        int index = getValidInt(sc);

        if (index >= 0) {
            list.expandAndUpdateWithInput(index, sc);
            list.updatedPrintArrayList();
        }
        else if (index == -1) {
        	list.printArrayList();
        }
        else {
        	System.out.println("Invalid index!");
        }

        
    }

    private static int getValidInt(Scanner sc) {
        while (!sc.hasNextInt()) {
            System.out.print("Invalid input. Enter a valid number: ");
            sc.next();
        }
        return sc.nextInt();
    }
}
